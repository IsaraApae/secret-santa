# Required in production. Any long random string (openssl rand -base64 32).
# It encrypts who drew whom. Changing it makes every existing draw unreadable.
SEAL_SECRET=

# Redis: connect one from the Vercel Marketplace and these get set for you.
# (UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are read too.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or any Redis over TCP instead:
REDIS_URL=

# Only when hosting somewhere other than Vercel: the site's own address, with no slash at the end
# (https://santa.example.com). Link previews, robots.txt and the sitemap are written with it.
NEXT_PUBLIC_SITE_URL=
